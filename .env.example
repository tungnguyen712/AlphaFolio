# LLM
ANTHROPIC_API_KEY=sk-ant-replace_me
# Per-agent model tiering (cost-aware):
#   Opus   → Signal Analysis, Devil's Advocate, Synthesis (open-ended + adversarial + final judgment)
#   Sonnet → Portfolio Construction, Market Intelligence (structured reasoning, schema-bound)
#   Haiku  → Data Retrieval (extraction/parsing only)
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# Data providers
SEC_EDGAR_USER_AGENT="AlphaFolio Dev nguyenductung712@gmail.com"
TAVILY_API_KEY=tvly-replace_me
FINNHUB_API_KEY=replace_me  # free at finnhub.io — needed for historical research mode

